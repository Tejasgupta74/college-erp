# Environment Configuration Template for College ERP System
# Copy this file to .env and replace placeholder values with your production secrets

# Server Configuration
PORT=8000
NODE_ENV=production

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/college_erp?retryWrites=true&w=majority

# JSON Web Token Secret (MUST be at least 32 characters in production)
JWT_SECRET=production_strong_jwt_secret_key_minimum_32_chars_long_2026
JWT_EXPIRE=7d

# CORS Allowed Origin
CORS_ORIGIN=https://erp.college.edu
CLIENT_URL=https://erp.college.edu

# Logging Configuration
LOG_LEVEL=info
CONSOLE_LOGS=false
