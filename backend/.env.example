# Environment Configuration Template for College ERP System
# Copy this file to .env and replace placeholder values with your secure secrets

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/college_erp_dev

# JSON Web Token Secret (generate a secure random 32+ char secret in production)
JWT_SECRET=replace_with_your_own_secure_32_character_secret_key_here
JWT_EXPIRE=7d

# CORS Allowed Origin (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
CONSOLE_LOGS=true
